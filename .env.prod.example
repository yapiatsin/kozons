# Configuration de production (VPS) — copier en /opt/kozons/.env et compléter.
# DB_ENGINE, DB_HOST, DB_PORT et KOZONS_REDIS_URL sont imposés par docker-compose.yml.

SECRET_KEY=a-generer-voir-commande-ci-dessous
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DEBUG=False
ALLOWED_HOSTS=kozonstic.com,www.kozonstic.com,127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=https://kozonstic.com,https://www.kozonstic.com

# PostgreSQL (conteneur kozons-db)
DB_NAME=kozons
DB_USER=kozons
DB_PASSWORD=a-generer

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=votre-adresse@gmail.com
EMAIL_HOST_PASSWORD=mot-de-passe-d-application
EMAIL_TIMEOUT=30
DEFAULT_FROM_EMAIL=Kozons <votre-adresse@gmail.com>

PASSWORD_RESET_OTP_MINUTES=10
LOGIN_OTP_MINUTES=10

# Appels hors réseau local (optionnel) :
# KOZONS_TURN_URL=turn:turn.exemple.com:3478
# KOZONS_TURN_USER=
# KOZONS_TURN_PASSWORD=
