# Configuration de production (VPS) — copier en /opt/kozons/.env et compléter.
# DB_ENGINE, DB_HOST, DB_PORT et KOZONS_REDIS_URL sont imposés par docker-compose.yml.

SECRET_KEY=a-generer-voir-commande-ci-dessous
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DEBUG=False
ALLOWED_HOSTS=kozonstic.com,www.kozonstic.com,127.0.0.1,localhost,kozons-web
CSRF_TRUSTED_ORIGINS=https://kozonstic.com,https://www.kozonstic.com

# PostgreSQL (conteneur kozons-db)
DB_NAME=kozons
DB_USER=kozons
DB_PASSWORD=a-generer

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=votre-adresse@gmail.com
EMAIL_HOST_PASSWORD=mot-de-passe-d-application
EMAIL_TIMEOUT=30
DEFAULT_FROM_EMAIL=Kozons <votre-adresse@gmail.com>

PASSWORD_RESET_OTP_MINUTES=10

# Serveur TURN (conteneur kozons-turn) pour les appels audio/vidéo
# python3 -c "import secrets; print(secrets.token_hex(32))"
TURN_SECRET=a-generer
TURN_EXTERNAL_IP=76.13.56.177

# --- LIVE : serveur média kozons-live (vide = pair-à-pair, 20 spectateurs max) ---
LIVE_MEDIA_URL=https://kozonstic.com/live-media
# kozons-live appelle Django sur http://kozons-web:8000 : ce nom doit figurer dans ALLOWED_HOSTS.
LIVE_P2P_MAX_VIEWERS=20


# --- IA (Brady, notes Meet) : modèle GRATUIT GPT-OSS 120B via Groq ---
# Clé gratuite, sans carte bancaire : https://console.groq.com/keys
AI_API_KEY=
# AI_API_BASE=https://api.groq.com/openai/v1
# AI_MODEL=openai/gpt-oss-120b
# AI_REASONING_EFFORT=low
# Autre fournisseur gratuit, ex. Gemini : AI_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai et AI_MODEL=gemini-2.5-flash
# Optionnel (payant) : Claude, utilisé seulement si AI_API_KEY est vide.
ANTHROPIC_API_KEY=
# --- Abonnement des boutiques : GeniusPay (https://pay.genius.ci) ---
# Adresse publique du site (retour après paiement). Webhook : <PUBLIC_BASE_URL>/api/shop/geniuspay/webhook
PUBLIC_BASE_URL=
GENIUSPAY_API_KEY=
GENIUSPAY_API_SECRET=
GENIUSPAY_WEBHOOK_SECRET=
# GENIUSPAY_BASE_URL=https://pay.genius.ci/api/v1/merchant
# SHOP_MONTHLY_PRICE=250
