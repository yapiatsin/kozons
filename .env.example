# Copiez ce fichier en .env et remplissez les valeurs.

SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=votre-adresse@gmail.com
EMAIL_HOST_PASSWORD=mot-de-passe-d-application
EMAIL_TIMEOUT=30
DEFAULT_FROM_EMAIL=Kozons <votre-adresse@gmail.com>

PASSWORD_RESET_OTP_MINUTES=10

# --- Connexion (code par e-mail) ---
LOGIN_OTP_MINUTES=10
